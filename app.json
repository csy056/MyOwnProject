{
  "expo": {
    "name": "경계선",
    "slug": "borderline",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "borderline",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0f10",
    "ios": {
      "bundleIdentifier": "com.borderline.game",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.borderline.game",
      "adaptiveIcon": {
        "backgroundColor": "#0e0f10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "lang": "ko"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e0f10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "지금 있는 시·군·구를 이야기의 무대로 삼고, 러닝으로 되찾은 블록을 기록하는 데 위치를 사용합니다. 좌표는 기기 밖으로 전송되지 않습니다.",
          "locationAlwaysAndWhenInUsePermission": "러닝 중 화면을 꺼도 달린 길을 블록으로 기록하기 위해 위치를 사용합니다. 러닝을 끝내면 위치 수집도 멈추며, 좌표는 기기 밖으로 전송되지 않습니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
