// =====================================================================
// 거점 — base_visit
//
// 하루에 한 가지만 한다. (분배기 base 가 이 터널이 끝나면 하루를 넘긴다)
//   - 사람들을 찾아간다: 한서진 / 강도윤 / 마 선생 / 윤보라. 찾아갈 때마다 대화가 한 단계씩 나아간다.
//     단계마다 장(chapter)과 신뢰(trust) 조건이 있다. 장이 모자라면 짧은 일상 장면,
//     신뢰가 모자라면 말을 아끼는 장면으로 대신한다.
//   - 부품으로 거점을 손본다: 정수기(부품 3) / 발전기(부품 4) / 방벽(부품 5). 아직 없고 부품이 될 때만 보인다.
//     신뢰가 낮으면 거들어 주는 손이 없어 체력이 깎이고, 높으면 신뢰가 더 오른다.
//   - 거점 일을 돕는다: 지붕·텃밭·신발·배식 중 하나를 골라 돕는다. 신뢰 +1과 작은 식량·부품. 신뢰가 아주 높으면 덤이 붙는다.
//
// 대화 단계 (chapter는 끝낸 장 수)
//   한서진 1 무조건          그날 새벽, 야근하다 깬 구청 옥상에서 본 벽의 곡선. "어디서 많이 본 곡선"
//          2 ch1             지적과 민원. 반 뼘 때문에 허물던 담장들
//          3 ch3, 신뢰 2     지도의 단 하나뿐인 거짓말: 벽선 너머 이백 미터, 서진의 집 (bv_sj_house)
//          4 ch4, 신뢰 3     "그 서류철 얘기, 마저 할게요." 4장 끝에 꽂아 둔 빈 서류철(설명회, "불일치 영")의 심화판.
//                            공문, 박수 치지 않은 이유, 표지의 가는 격자. 사업 이름은 기억하지 못한다.
//                            (더 물으면: "사람이 안 다니는 땅은 확인할 수 없는 땅")
//          5 ch6, 신뢰 5     닳은 지우개를 맡긴다. "제가 바래면, 지도는 그쪽이 맡아요."
//   강도윤 1 무조건          타이어 고무 밑창, 일 분에 백팔십 걸음
//          2 ch1             바람막이 안쪽의 배번. 벽 생기고 사흘 뒤였던 전국 대회 삼천 미터. 대회장은 벽 너머
//          3 ch3~4           밤마다 맨발로 태민의 매트리스 둘레를 돈다 (5장 이후에는 건너뛴다)
//          4 ch4             마라톤의 벽. 언젠가 {dome_name}의 벽을 따라 한 바퀴 돌겠다, 페이스메이커 해 달라
//          5 ch5, 신뢰 3     "보라 쌤 밤마다 어디 가?" 알고 있으면 말할지 고른다 (bv_told_doyun)
//          6 ch6, 신뢰 4     배번을 이쪽 가슴에 꽂아 준다. "기록 없으면 안 뛴 거야."
//   마 선생 1 무조건         줄자는 마음으로 당긴다. 그래서 내가 잰 땅은 다 조금씩 넓다
//          2 ch1             걸음으로 재는 법. 백 미터에 백삼십 걸음
//          3 ch3             [선택 단서] 삼각점 이야기 또는 곶감과 옛날얘기
//          4 ch5, 신뢰 3     [선택 단서] 바래는 야장 또는 재미난 얘기
//          5 ch6             오십 미터 줄자를 물려준다. 쇠고리에 긁어 새긴 이름들
//          (단서를 사양했으면 나중에 다시 찾아갔을 때 또 권한다)
//   윤보라 1 무조건          물집 치료. 응급실 밤 근무. "사람은 새벽 네 시에 제일 많이 죽고 제일 많이 태어나"
//          2 ch1             빨간 립스틱. 회색 구역에서 정신을 붙드는 법
//          3 ch2, (1장에서 따라갔거나 신뢰 3)  정류장의 남편. 팔 년 탄 일곱 시 사십 분 버스, 텀블러, 그날의 첫차
//          4 ch4, 신뢰 3     홍채 색 공책. 보라 자신의 쪽을 대신 칠해 달라고 한다
//                            (외부인: 이쪽 쪽만 첫날부터 하나도 옅어지지 않았다. 4장 아침 검사에서 먼저 보여 준다.
//                             여기서는 "못 세니까 지우지도 못한다"까지 말한다)
//          5 ch6, 신뢰 4     정류장 둘레에 같이 고리를 긋는다. 남편이 처음으로 컵을 들어 마신다 (bv_bus_loop)
//
// 이 파일에서 정한 사실
//   - 한서진의 집은 벽선 바로 건너편, 벽에서 이백 미터. 그날 밤 서진은 야근하다 사무실에서 잠들었다.
//   - 윤보라의 남편은 출장 가려고 첫차를 타러 나갔다가 정류장에서 회색이 되었다. 이름은 정하지 않았다.
//   - 강도윤은 전국 대회 삼천 미터 예선을 통과했었다. 대회는 벽 생기고 사흘 뒤였다.
//
// 이 파일에서 선언하는 전역 변수
//   bv_sj, bv_dy, bv_ma, bv_br : 각 인물과 나눈 대화 단계 (0부터)
//   bv_sj_house   : "erased" 서진 대신 집 표시를 지웠다 / "kept" 물음표를 붙여 남겼다
//   bv_told_doyun : 도윤에게 보라의 남편 이야기를 했다. 도윤이 그날 밤 보라를 따라갔다
//   bv_bus_loop   : 보라와 정류장 둘레를 돌았다. 남편이 컵을 들어 마셨다
//   bv_ma_c1, bv_ma_c2 : 마 선생의 단서 두 개를 받았다
//
// 단서 (선택, 최대 2개)
//   # CLUE: 지도에 박힌 못   삼각점은 모든 지도의 영점. 벽 생긴 뒤 십자 홈에만 색이 남고 돌이 따뜻했다
//   # CLUE: 바래는 야장      삼십 년 전 측량 기록이 회색 구역 줄만 바래고, 선꾼이 지나간 줄은 다시 진해진다
// =====================================================================

VAR bv_sj = 0
VAR bv_dy = 0
VAR bv_ma = 0
VAR bv_br = 0
VAR bv_sj_house = ""
VAR bv_told_doyun = false
VAR bv_bus_loop = false
VAR bv_ma_c1 = false
VAR bv_ma_c2 = false

=== function bv_office() ===
{
- area_kind == "county":
    ~ return "군청"
- area_kind == "city":
    ~ return "시청"
- else:
    ~ return "구청"
}

=== function bv_can_build() ===
{ not up_water && parts >= 3:
    ~ return true
}
{ not up_generator && parts >= 4:
    ~ return true
}
{ not up_barricade && parts >= 5:
    ~ return true
}
~ return false

// ---------------------------------------------------------------------
// 하루의 시작과 메뉴
// ---------------------------------------------------------------------
=== base_visit ===
# TITLE: 거점의 하루
{ is_night:
    {shuffle:
    - 밤의 {base_place()}. 매트리스 사이로 코 고는 소리가 두 박자로 오간다. 깨어 있는 사람은 늘 정해져 있다.
    - 복도 끝 창가에서 누군가 촛불 하나로 양말을 깁는다. 바늘이 지나갈 때마다 그림자가 벽을 크게 꿰맨다.
    - 현관 유리문 바깥쪽에 입김 자국이 남아 있다. 누가 들여다보다 간 자리다. 안에서는 다들 못 본 척한다.
    }
- else:
    {shuffle:
    - 마당 빨랫줄에 셔츠들이 걸려 있다. 바람이 불 때마다 소매들이 한쪽으로 손짓한다. 벽 쪽이다.
    - 오전의 {base_place()}. 누구는 냄비를 닦고, 누구는 밑창에 고무를 덧대고, 누구는 그 옆에서 졸다 깬다. 사람 사는 소리가 잔잔하다.
    - 계단참에서 아이 둘이 서로의 운동화 끈을 바꿔 묶는다. 고리 하나에 한 번 더 감기. 누구한테 배웠는지 뻔하다.
    }
}
{ up_water:
    정수기 꼭지에서 물방울이 일정하게 떨어진다. 다들 그 소리로 시간을 가늠한다.
}
{ up_generator:
    발전기가 고르게 돈다. 형광등은 더는 떨지 않고, 벽의 웅웅거림은 이 안까지 들어오지 못한다.
}
{ up_barricade:
    방벽 안쪽 면에 적힌 이름들이 오늘도 또렷하다.
}
-> bv_menu

= bv_menu
오늘 하루, 손이 닿는 일은 하나뿐이다.
+ [사람들을 찾아간다]
    -> bv_people
+ {bv_can_build()} [부품으로 거점을 손본다]
    -> bv_build
+ [거점 일을 돕는다]
    -> bv_chores

= bv_people
{ is_night:
    서진의 자리에만 스탠드가 켜져 있다. 도윤은 현관 계단에, 마 선생은 이불을 둘러쓰고 라디오 옆에, 보라는 보온병을 든 채 문가에 있다.
- else:
    서진은 지도 앞에, 도윤은 계단참에, 마 선생은 볕 드는 창가에, 보라는 약 상자 옆에 있다.
}
+ [한서진에게 간다]
    -> bv_to_sj
+ [강도윤에게 간다]
    -> bv_to_dy
+ [마 선생에게 간다]
    -> bv_to_ma
+ [윤보라에게 간다]
    -> bv_to_br

// ---------------------------------------------------------------------
// 한서진
// ---------------------------------------------------------------------
= bv_to_sj
{
- bv_sj == 0:
    -> bv_sj_1
- bv_sj == 1 && chapter >= 1:
    -> bv_sj_2
- bv_sj == 2 && chapter >= 3:
    { trust >= 2:
        -> bv_sj_3
    }
    -> bv_sj_guard
- bv_sj == 3 && chapter >= 4:
    { trust >= 3:
        -> bv_sj_4
    }
    -> bv_sj_guard
- bv_sj == 4 && chapter >= 6:
    { trust >= 5:
        -> bv_sj_5
    }
    -> bv_sj_guard
}
-> bv_sj_idle

= bv_sj_1
~ bv_sj = 1
~ add_mind(1)
# CLEAR
# TITLE: 한서진
서진이 오늘 들어온 선꾼 기록을 지도에 옮기고 있다. 빨간 펜이 골목을 따라가다 모퉁이에서 망설임 없이 꺾인다.
"그날 새벽 얘기요?" 묻기도 전에 서진이 먼저 말한다. 다들 한 번은 묻는 모양이다.
"야근하다 {bv_office()} 사무실 소파에서 잠들었어요. 네 시 십이 분에 눈이 떠졌어요. 창밖이 하얘서, 눈이 온 줄 알았어요."
"옥상에 올라갔어요. 벽이 동네를 빙 두르고 있었어요. 그 곡선을 한참 봤어요. 어디서 많이 본 곡선이었거든요."
펜 끝이 지도 가장자리, 벽을 그린 굵은 선 위에서 멈춘다. "스무 해 동안 매일 보던 선이었어요. 아무한테도 말 안 했어요. 미친 소리 같아서."
"그래서 지도부터 그렸어요. 미친 소리도 지도로 그려 놓으면 덜 미쳐 보이거든요."
->->

= bv_sj_2
~ bv_sj = 2
~ add_trust(1)
# CLEAR
# TITLE: 한서진
서진의 손에 지우개가 들려 있다. 지울 블록이 없는 날에도 손에 있다. 버릇이다.
"지적과에서 제일 많이 받은 민원이 뭔지 알아요? 담장이요. 옆집 담이 우리 땅을 반 뼘 먹었다."
"나가서 재 보면 대개 맞았어요. 정말 반 뼘이 넘어와 있었어요. 그런데 지도를 고치자는 사람은 없었어요. 다들 담을 허물라고 했죠."
지우개가 손바닥 위에서 구른다. "삼십 년 된 담이 반 뼘 때문에 무너지는 걸 몇 번 봤어요. 그때 처음 생각했어요. 사람이 지도를 따라 사는 게 맞나."
창밖, 벽 쪽 하늘이 옅다.
"이제는 담 대신 벽이 서 있네요. 반 뼘도 안 틀리고." 서진이 지우개를 내려놓는다. "민원 넣을 데도 없고요."
->->

= bv_sj_3
~ bv_sj = 3
# CLEAR
# TITLE: 한서진
회의실에 서진 혼자다. 지도 앞 의자에 앉아, 지도가 아니라 지도 바깥을 보고 있다. 벽선 너머의 여백이다.
그 여백에 연필로 그린 아주 작은 네모가 하나 있다. 벽선 바로 건너편. 이 지도의 다른 칸은 전부 누군가 걸어서 칠했다. 그 네모만은 아무도 걸어 본 적이 없다.
"제 집이에요." 서진이 먼저 말한다. "벽에서 이백 미터. 그날 밤 저는 여기 있었고, 집은 저기 있었어요."
"걸은 데만 칠하라고 했죠. 그 말을 제일 먼저 어긴 사람이 저예요. 이 지도에서 거짓말은 저거 하나예요."
서진이 지우개를 내민다. 지우개 끝이 아주 조금 떨린다.
"지울까요."
+ [대신 지워 준다]
    ~ bv_sj_house = "erased"
    ~ add_trust(2)
    ~ add_mind(-1)
    # CLEAR
    지우개를 받는다. 연필 자국은 얇다. 세 번 문지르자 네모가 없어진다. 종이에 보풀이 조금 인다.
    서진이 지우개 가루를 손날로 쓸어 모은다. 버리지 않는다. 작은 봉투에 담아 가슴 주머니에 넣는다.
    "고마워요." 목소리가 평소와 똑같다. 그래서 더 오래 귀에 남는다.
+ [그대로 두라고 한다]
    ~ bv_sj_house = "kept"
    ~ add_mind(1)
    # CLEAR
    "거짓말 말고 메모라고 하죠. 나중에 걸어서 확인할."
    서진이 한참 말이 없다. 그러다 연필을 들어 네모 옆에 아주 작은 물음표를 붙인다.
    "지적도에도 이런 표시가 있어요. 미확정. 측량이 끝나지 않은 땅." 서진이 연필을 내려놓는다. "그렇게 해 두죠."
- ->->

= bv_sj_4
~ bv_sj = 4
# CLEAR
# TITLE: 한서진
서진이 지적도 옆에 꽂아 둔 누런 서류철을 뽑아 무릎에 놓는다. 관청 마크. 속은 여전히 비어 있다.
"그 서류철 얘기, 마저 할게요. 공문이 먼저 왔어요. 전국 지적 자료를 한 체계로 묶는다고. 지도와 현실의 차이를 저절로 잡아 준다고."
"설명회 화면에 불일치 영이 뜨자 다들 박수를 쳤어요. 저는 안 쳤어요." 서진이 빈 서류철을 쓰다듬는다. "반 뼘짜리 담장들이 생각나서요. 불일치를 영으로 만드는 방법은 두 가지예요. 지도를 고치거나, 땅을 고치거나."
"사업 이름이 기억이 안 나요. 이상하죠. 다른 건 다 기억하는데." 서진이 미간을 누른다. "표지 무늬만 생각나요. 가는 격자. 학교 다닐 때 쓰던 공책 같은."
창밖, 벽 표면에 희미한 격자가 비친다. 서진은 그쪽을 보지 않는다.
+ [더 묻는다]
    ~ add_trust(-1)
    ~ add_mind(-1)
    # CLEAR
    "설명회에서 또 무슨 말을 했어요?"
    서진이 오래 망설인다. 그러다 누군가의 말투를 그대로 옮긴다. 억양 없이, 또박또박. "사람이 다니지 않는 땅은 확인할 수 없는 땅입니다. 확인할 수 없는 땅은 정리 대상입니다."
    "그날 그 말을 듣고 웃었어요. 공무원 말투가 다 그렇거든요." 서진이 서류철을 덮는다. "지금은 못 웃겠네요. 오늘은 여기까지 해요."
+ [여기까지만 듣는다]
    ~ add_trust(1)
    # CLEAR
