= bv_to_dy
{
- bv_dy == 0:
    -> bv_dy_1
- bv_dy == 1 && chapter >= 1:
    -> bv_dy_2
- bv_dy == 2 && chapter >= 3 && chapter <= 4:
    -> bv_dy_3
- bv_dy == 2 && chapter >= 5:
    ~ bv_dy = 3
    -> bv_dy_4
- bv_dy == 3 && chapter >= 4:
    -> bv_dy_4
- bv_dy == 4 && chapter >= 5:
    { trust >= 3:
        -> bv_dy_5
    }
    -> bv_dy_guard
- bv_dy == 5 && chapter >= 6:
    { trust >= 4:
        -> bv_dy_6
    }
    -> bv_dy_guard
}
-> bv_dy_idle

